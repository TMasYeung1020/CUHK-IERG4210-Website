Create LHS navigation:

<style>
    *{
        padding:0;
        margin:0;
        text-decoration: None;
        list-style: None;
        box-sizing: border-box;
    }
    body{
        font-family: 'Times New Roman', Times, serif;
    }
    nav ul{
        float:left;
    }
    nav ul li{
        display: inline-block;
        line-height: 80px;
    }
    nav ul li a{
        color:black;
        font-size: 18px;
        background-color: antiquewhite;
    }

</style>


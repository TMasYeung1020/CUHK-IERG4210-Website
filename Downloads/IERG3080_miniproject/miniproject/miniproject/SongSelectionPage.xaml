<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>


        <!-- Expand/collapse animations for CenterTile -->
        <Storyboard x:Key="ExpandCenter">
            <DoubleAnimation Storyboard.TargetName="CenterTile" Storyboard.TargetProperty="Height" To="180" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="CenterInfo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20" />
        </Storyboard>
        <Storyboard x:Key="CollapseCenter">
            <DoubleAnimation Storyboard.TargetName="CenterTile" Storyboard.TargetProperty="Height" To="50" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="CenterInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Single row now: use most of area for header and content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background fills the page -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Overlay content: title and horizontal tiles -->
        <Grid Grid.Row="0" IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title only (no chevrons) -->
            <TextBlock Grid.Row="0" Text="Select Song" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,6" />

            <!-- Middle area: show center Play tile only -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Center tile (song1) with expandable area -->
                <Border x:Name="CenterTile" Width="210" Height="50" Background="#FFD700" BorderBrush="#000" BorderThickness="4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CenterTile_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="24K  TRIBE OF GOLD" FontSize="20" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Additional info that appears when expanded: three difficulty bars -->
                        <StackPanel Grid.Row="1" x:Name="CenterInfo" Opacity="0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8,6">
                            <!-- Easy bar (first) -->
                            <Border Background="#FFA84D" CornerRadius="8" Padding="6" Margin="0,4" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <!-- difficulty icon -->
                                    <Image Source="/easy.png" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0" />

                                    <!-- vertical Chinese label: Easy -->
                                    <TextBlock Text="Easy" FontWeight="Bold" Foreground="#000" FontSize="14" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">

                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Margin="8,0">
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <!-- Medium bar (second) -->
                            <Border Background="#FF8C1A" CornerRadius="8" Padding="6" Margin="0,4" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/medium.png" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0" />

                                    <TextBlock Text="Medium" FontWeight="Bold" Foreground="#000" FontSize="14" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Margin="8,0">
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="0.1" />
                                    </StackPanel>


                                </Grid>
                            </Border>

                            <!-- Hard bar (third) -->
                            <Border Background="#FF6A00" CornerRadius="8" Padding="6" Margin="0,4" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/hard.png" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0" />

                                    <TextBlock Text="Hard" FontWeight="Bold" Foreground="#000" FontSize="14" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Margin="8,0">
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="2" Opacity="1" />
                                    </StackPanel>


                                </Grid>
                            </Border>

                        </StackPanel>

                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom-left SETTING button with black hover overlay -->
            <Border x:Name="SettingCorner"
        Grid.Row="1"
        Width="160"
        Height="72"
        Background="#9FD3FF"
        BorderBrush="#000"
        BorderThickness="3"
        CornerRadius="8"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Margin="20"
        Cursor="Hand">

                <Button Background="Transparent" BorderThickness="0" Click="RightTile_MouseLeftButtonDown">
                    <!-- Keeps your existing click handler -->

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Original blue background -->
                                <Border Background="#9FD3FF"
                            CornerRadius="8"/>

                                <!-- Black hover overlay -->
                                <Border x:Name="HoverOverlay"
                            Background="Black"
                            Opacity="0"
                            CornerRadius="8"/>

                                <!-- Text -->
                                <TextBlock Text="SETTING"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Bottom-right BACK button with black hover overlay (same as difficulty buttons) -->
            <Border x:Name="BackCorner"
        Grid.Row="1" Width="160"
        Height="72"
        Background="#FF6B6B"
        BorderBrush="#000"
        BorderThickness="3"
        CornerRadius="8"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="20"
        Cursor="Hand">

                <Button Background="Transparent"
            BorderThickness="0"
            Click="LeftTile_MouseLeftButtonDown">
                    <!-- Keep your existing handler -->

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Original red background -->
                                <Border Background="#FF6B6B"
                            CornerRadius="8"/>

                                <!-- Black hover overlay -->
                                <Border x:Name="HoverOverlay"
                            Background="Black"
                            Opacity="0"
                            CornerRadius="8"/>

                                <!-- Text -->
                                <TextBlock Text="BACK"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Grid>
</Page>
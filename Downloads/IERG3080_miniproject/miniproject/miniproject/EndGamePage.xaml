<Page x:Class="miniproject.EndGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="EndGamePage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="End Game" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <Button x:Name="BtnReturn" Content="Return to Song Selection" Width="220" Height="36" Click="BtnReturn_Click" />
        </StackPanel>
    </Grid>
</Page>
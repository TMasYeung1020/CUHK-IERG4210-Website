<Page x:Class="miniproject.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="GamePage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Game" FontSize="24" HorizontalAlignment="Center" />
            <Button x:Name="BtnEnd" Content="End Game" Width="180" Height="36" Click="BtnEnd_Click" />
        </StackPanel>
    </Grid>
</Page>
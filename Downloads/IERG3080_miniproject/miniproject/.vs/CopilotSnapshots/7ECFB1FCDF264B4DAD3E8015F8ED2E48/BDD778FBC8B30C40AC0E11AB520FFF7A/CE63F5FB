<Page x:Class="miniproject.GameMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="GameMenuPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="Game Menu" FontSize="24" HorizontalAlignment="Center" />
            <Button x:Name="BtnSetup" Content="Setup" Width="180" Height="36" Click="BtnSetup_Click" />
            <Button x:Name="BtnPlay" Content="Play Game" Width="180" Height="36" Click="BtnPlay_Click" />
            <Button x:Name="BtnBack" Content="Back to Song Selection" Width="180" Height="36" Click="BtnBack_Click" />
        </StackPanel>
    </Grid>
</Page>
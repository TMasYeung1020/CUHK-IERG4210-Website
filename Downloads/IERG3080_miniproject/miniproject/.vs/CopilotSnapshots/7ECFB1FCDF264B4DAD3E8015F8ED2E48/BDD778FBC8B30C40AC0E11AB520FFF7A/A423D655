<Page x:Class="miniproject.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="SetupPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Setup" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <Button x:Name="BtnBackToMenu" Content="Back to Game Menu" Width="200" Height="36" Click="BtnBackToMenu_Click" />
        </StackPanel>
    </Grid>
</Page>
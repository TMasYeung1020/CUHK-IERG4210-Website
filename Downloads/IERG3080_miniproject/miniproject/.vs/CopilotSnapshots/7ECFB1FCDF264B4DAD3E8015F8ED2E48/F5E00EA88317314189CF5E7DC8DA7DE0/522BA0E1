<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>

        <!-- Separate ImageBrush resource for the left bottom half (unused now but kept) -->
        <ImageBrush x:Key="BottomBrushLeft"
                    ImageSource="/SongSelectionPageBottom2.png"
                    TileMode="Tile"
                    Viewport="0,0,1,0.12"
                    ViewportUnits="RelativeToBoundingBox"
                    Stretch="Fill">
            <ImageBrush.RelativeTransform>
                <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
            </ImageBrush.RelativeTransform>
        </ImageBrush>

        <!-- Expand/collapse animations for CenterTile -->
        <Storyboard x:Key="ExpandCenter">
            <DoubleAnimation Storyboard.TargetName="CenterTile" Storyboard.TargetProperty="Height" To="180" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="CenterInfo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Key="CollapseCenter">
            <DoubleAnimation Storyboard.TargetName="CenterTile" Storyboard.TargetProperty="Height" To="50" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="CenterInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Single row now: use most of area for header and content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background fills the page -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Overlay content: title and horizontal tiles -->
        <Grid Grid.Row="0" IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title only (no chevrons) -->
            <TextBlock Grid.Row="0" Text="Select Song" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,6" />

            <!-- Middle area: show center Play tile only -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Center tile (song1) with expandable area -->
                <Border x:Name="CenterTile" Width="220" Height="50" Background="#FFD700" BorderBrush="#000" BorderThickness="4" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CenterTile_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SongName" FontSize="20" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Additional info that appears when expanded -->
                        <StackPanel Grid.Row="1" x:Name="CenterInfo" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6">
                            <TextBlock Text="Singer Name" FontSize="14" Foreground="#333" HorizontalAlignment="Center" />
                            <TextBlock Text="Easy" FontSize="14" Foreground="#333" HorizontalAlignment="Center" />
                            <TextBlock Text="Normal" FontSize="14" Foreground="#333" HorizontalAlignment="Center" />
                            <TextBlock Text="Hard" FontSize="14" Foreground="#333" HorizontalAlignment="Center" />
                        </StackPanel>

                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom-left setting button -->
            <Border x:Name="SettingCorner" Grid.Row="1" Width="160" Height="72" Background="#9FD3FF" BorderBrush="#000" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20" MouseLeftButtonDown="RightTile_MouseLeftButtonDown" Cursor="Hand">
                <TextBlock Text="SETTING" FontSize="18" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Bottom-right back button -->
            <Border x:Name="BackCorner" Grid.Row="1" Width="160" Height="72" Background="#FF6B6B" BorderBrush="#000" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" MouseLeftButtonDown="LeftTile_MouseLeftButtonDown" Cursor="Hand">
                <TextBlock Text="BACK" FontSize="18" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

    </Grid>
</Page>
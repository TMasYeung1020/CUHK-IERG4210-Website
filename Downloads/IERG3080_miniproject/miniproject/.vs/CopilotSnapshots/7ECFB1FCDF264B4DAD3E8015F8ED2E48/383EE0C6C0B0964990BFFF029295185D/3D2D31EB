<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-1" Duration="0:0:8" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Rows: top 80% (4*), bottom 20% (1*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.25,1"
                            ViewportUnits="RelativeToBoundingBox">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Bottom: split into two 50% columns, left tiled rotated -90, right tiled not rotated -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/SongSelectionPageBottom2.png"
                                TileMode="Tile"
                                Viewport="0,0,0.12,1"
                                ViewportUnits="RelativeToBoundingBox">
                        <ImageBrush.RelativeTransform>
                            <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Grid.Column="1">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="/SongSelectionPageBottom.png"
                                TileMode="Tile"
                                Viewport="0,0,0.12,1"
                                ViewportUnits="RelativeToBoundingBox" />
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

    </Grid>
</Page>
<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="SongSelectionPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Song Selection" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <Button x:Name="BtnToGameMenu" Content="Go to Game Menu" Width="200" Height="40" Click="BtnToGameMenu_Click" />
        </StackPanel>
    </Grid>
</Page>
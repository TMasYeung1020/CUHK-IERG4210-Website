<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>

        <!-- Separate ImageBrush resources for the bottom halves -->
        <ImageBrush x:Key="BottomBrushLeft"
                    ImageSource="/SongSelectionPageBottom2.png"
                    TileMode="Tile"
                    Viewport="0,0,1,0.12"
                    ViewportUnits="RelativeToBoundingBox"
                    Stretch="Fill">
            <ImageBrush.RelativeTransform>
                <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
            </ImageBrush.RelativeTransform>
        </ImageBrush>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Rows: top 80% (4*), bottom 20% (1*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Overlay content on top of the top background -->
        <Grid Grid.Row="0" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with chevrons and title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,6" IsHitTestVisible="True">
                <TextBlock Text="&lt;" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="12,0" VerticalAlignment="Center" />
                <Border Background="#00FFFFFF" Padding="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Select Song" FontSize="48" FontWeight="Bold" Foreground="#FFFAF0" 
                               FontFamily="Segoe Script" TextOptions.TextFormattingMode="Ideal">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
                <TextBlock Text=">" FontSize="28" FontWeight="Bold" Foreground="Black" Margin="12,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Horizontal list of vertical tiles -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,20,20,20" IsHitTestVisible="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sample tiles: adjust colors and labels as needed -->
                    <Border Width="90" Height="380" Background="#E6F7F7" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0" Effect="{StaticResource {x:Static SystemParameters.DropShadowKey}}">
                        <TextBlock Text="ICARUS" FontSize="20" FontWeight="Bold" Foreground="#4b6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#E6F7F7" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="D" FontSize="20" FontWeight="Bold" Foreground="#4b6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#E6F7F7" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="Predator's Crypto Pt1" FontSize="18" FontWeight="Bold" Foreground="#456" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <!-- highlighted tile -->
                    <Border Width="90" Height="380" Background="#FFD700" BorderBrush="#000" BorderThickness="8" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="Random Song" FontSize="18" FontWeight="Bold" Foreground="#000" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <!-- More tiles (reused colors) -->
                    <Border Width="90" Height="380" Background="#E6F7F7" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="Stats" FontSize="20" FontWeight="Bold" Foreground="#456" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#E6F7F7" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="Leaderboard" FontSize="18" FontWeight="Bold" Foreground="#456" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#FF6B6B" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="Search Songs" FontSize="18" FontWeight="Bold" Foreground="#fff" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#28D6A3" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="How to Play" FontSize="18" FontWeight="Bold" Foreground="#fff" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <Border Width="90" Height="380" Background="#9FD3FF" BorderBrush="#000" BorderThickness="6" CornerRadius="4" Margin="8,0">
                        <TextBlock Text="About Simulator" FontSize="16" FontWeight="Bold" Foreground="#fff" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom: split into two 50% columns, use the separated ImageBrush resources -->
        <Grid Grid.Row="1" x:Name="BottomGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="{StaticResource BottomBrushLeft}" />

            <Rectangle Grid.Column="1" Fill="White" />

        </Grid>

    </Grid>
</Page>
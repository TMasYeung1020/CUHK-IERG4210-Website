<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>

        <!-- Separate ImageBrush resource for the left bottom half -->
        <ImageBrush x:Key="BottomBrushLeft"
                    ImageSource="/SongSelectionPageBottom2.png"
                    TileMode="Tile"
                    Viewport="0,0,1,0.12"
                    ViewportUnits="RelativeToBoundingBox"
                    Stretch="Fill">
            <ImageBrush.RelativeTransform>
                <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
            </ImageBrush.RelativeTransform>
        </ImageBrush>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Rows: top 80% (4*), bottom 20% (1*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Centered title with chevrons (interactive) -->
        <Grid Grid.Row="0" IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                <Button x:Name="BtnLeft" Click="BtnLeft_Click" Background="Transparent" BorderThickness="0" Padding="8" Margin="12,0">
                    <TextBlock Text="&lt;" FontSize="48" FontWeight="Bold" Foreground="White" />
                </Button>

                <TextBlock Text="Select Song" FontSize="48" FontWeight="Bold" Foreground="White" Margin="12,0" VerticalAlignment="Center" />

                <Button x:Name="BtnRight" Click="BtnRight_Click" Background="Transparent" BorderThickness="0" Padding="8" Margin="12,0">
                    <TextBlock Text=">" FontSize="48" FontWeight="Bold" Foreground="White" />
                </Button>
            </StackPanel>

            <!-- Middle area: show two tiles side by side, left is red and clickable -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LeftTile" Width="100" Height="320" Background="#FF6B6B" BorderBrush="#000" BorderThickness="6" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="LeftTile_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,12,0">
                    <TextBlock Text="Random" FontSize="16" FontWeight="Bold" Foreground="#fff" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <Border x:Name="CenterTile" Width="100" Height="320" Background="#FFD700" BorderBrush="#000" BorderThickness="6" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CenterTile_MouseLeftButtonDown" Cursor="Hand">
                    <TextBlock Text="Random Song" FontSize="16" FontWeight="Bold" Foreground="#000" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom: split into two 50% columns, left tiled rotated -90, right solid white -->
        <Grid Grid.Row="1" x:Name="BottomGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="{StaticResource BottomBrushLeft}" />

            <Rectangle Grid.Column="1" Fill="White" />

        </Grid>

    </Grid>
</Page>
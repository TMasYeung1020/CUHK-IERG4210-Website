<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>

        <!-- Separate ImageBrush resources for the bottom halves -->
        <ImageBrush x:Key="BottomBrushLeft"
                    ImageSource="/SongSelectionPageBottom2.png"
                    TileMode="Tile"
                    Viewport="0,0,1,0.12"
                    ViewportUnits="RelativeToBoundingBox"
                    Stretch="Fill">
            <ImageBrush.RelativeTransform>
                <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
            </ImageBrush.RelativeTransform>
        </ImageBrush>

        <!-- Right brush: show original image at its natural size top-left and tile across -->
        <ImageBrush x:Key="BottomBrushRight"
                    ImageSource="/SongSelectionPageBottom.png"
                    TileMode="Tile"
                    ViewportUnits="Absolute"
                    Viewport="0,0,300,200"
                    Stretch="None"
                    AlignmentX="Left"
                    AlignmentY="Top" />
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Rows: top 80% (4*), bottom 20% (1*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Bottom: split into two 50% columns, use the separated ImageBrush resources -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="{StaticResource BottomBrushLeft}" />

            <Rectangle Grid.Column="1" Fill="{StaticResource BottomBrushRight}" />
        </Grid>

    </Grid>
</Page>
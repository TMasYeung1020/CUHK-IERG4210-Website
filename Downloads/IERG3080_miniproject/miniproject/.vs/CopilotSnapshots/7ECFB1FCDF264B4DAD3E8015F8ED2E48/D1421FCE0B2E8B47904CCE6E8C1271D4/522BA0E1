<Page x:Class="miniproject.SongSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SongSelectionPage">

    <Page.Resources>
        <Storyboard x:Key="TopScrollStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TopRect"
                             Storyboard.TargetProperty="(Rectangle.Fill).(ImageBrush.RelativeTransform).(TranslateTransform.X)"
                             From="0" To="-0.5" Duration="0:0:6" />
        </Storyboard>

        <!-- Separate ImageBrush resource for the left bottom half (unused now but kept) -->
        <ImageBrush x:Key="BottomBrushLeft"
                    ImageSource="/SongSelectionPageBottom2.png"
                    TileMode="Tile"
                    Viewport="0,0,1,0.12"
                    ViewportUnits="RelativeToBoundingBox"
                    Stretch="Fill">
            <ImageBrush.RelativeTransform>
                <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5" />
            </ImageBrush.RelativeTransform>
        </ImageBrush>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource TopScrollStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Single row now: use most of area for header and content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top: tiled/scrolling background fills the page -->
        <Rectangle x:Name="TopRect" Grid.Row="0">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/SongSelectionPageTop.png"
                            TileMode="Tile"
                            Viewport="0,0,0.5,1"
                            ViewportUnits="RelativeToBoundingBox"
                            Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <TranslateTransform X="0" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Overlay content: title and horizontal tiles -->
        <Grid Grid.Row="0" IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title only (no chevrons) -->
            <TextBlock Grid.Row="0" Text="Select Song" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,6" />

            <!-- Middle area: show three horizontal tiles side by side -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Setting button (now left) -->
                <Border x:Name="RightTile" Width="180" Height="80" Background="#9FD3FF" BorderBrush="#000" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="RightTile_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,12,0">
                    <TextBlock Text="Setting" FontSize="18" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Center tile (song1) as horizontal rectangle -->
                <Border x:Name="CenterTile" Width="180" Height="80" Background="#FFD700" BorderBrush="#000" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CenterTile_MouseLeftButtonDown" Cursor="Hand" Margin="0,0,12,0">
                    <TextBlock Text="Play" FontSize="20" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Back button (now right) -->
                <Border x:Name="LeftTile" Width="180" Height="80" Background="#FF6B6B" BorderBrush="#000" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="LeftTile_MouseLeftButtonDown" Cursor="Hand">
                    <TextBlock Text="Back" FontSize="18" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

    </Grid>
</Page>
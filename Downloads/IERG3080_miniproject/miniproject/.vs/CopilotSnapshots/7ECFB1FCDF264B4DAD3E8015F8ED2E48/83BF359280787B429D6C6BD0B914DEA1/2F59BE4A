<Page x:Class="miniproject.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:miniproject"
      Title="StartPage">
    <Page.Resources>
        <!-- Brush used for the prompt so we can animate its Color -->
        <SolidColorBrush x:Key="PromptBrush" Color="White" />

        <!-- Storyboard: cycle through rainbow colors and fade in/out every 1 second -->
        <Storyboard x:Key="PromptStoryboard" RepeatBehavior="Forever">
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="PromptText" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Duration="0:0:1">
                <LinearColorKeyFrame Value="Red" KeyTime="0:0:0" />
                <LinearColorKeyFrame Value="Orange" KeyTime="0:0:0.2" />
                <LinearColorKeyFrame Value="Yellow" KeyTime="0:0:0.4" />
                <LinearColorKeyFrame Value="Green" KeyTime="0:0:0.6" />
                <LinearColorKeyFrame Value="Blue" KeyTime="0:0:0.8" />
                <LinearColorKeyFrame Value="Magenta" KeyTime="0:0:1" />
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PromptText" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0" />
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.5" />
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Page.Background>
        <ImageBrush ImageSource="/StartPageBKG.png" Stretch="UniformToFill" />
    </Page.Background>

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PromptStoryboard}" />
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" x:Name="BottomRow" />
        </Grid.RowDefinitions>

        <!-- Centered logo -->
        <Image Grid.Row="1" x:Name="LogoImage" Source="/StartPageLogo.png" 
               HorizontalAlignment="Center" VerticalAlignment="Center" 
               Stretch="Uniform"
               StretchDirection="Both"
               Width="300" Height="200"/>

        <!-- Prompt placed in the bottom row; actual vertical offset will be set in code-behind to be halfway in the bottom space -->
        <TextBlock Grid.Row="2" x:Name="PromptText" Text="Click or Press Enter" FontSize="28" Foreground="{StaticResource PromptBrush}"
                   HorizontalAlignment="center" VerticalAlignment="Top" Margin="150,20,0,0" />
    </Grid>
</Page>
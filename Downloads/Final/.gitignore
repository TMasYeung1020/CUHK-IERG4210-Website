# Git LFS 追蹤設定（如果專案內有設定）
/[Aa]ssets/[Mm]odels/**/*.{fbx,obj}
/[Aa]ssets/[Tt]extures/**/*.{png,jpg,jpeg,tga,psd}
/[Aa]ssets/[Aa]udio/**/*.{wav,mp3,ogg}

# 絕對不要上傳的 Unity 核心暫存資料夾
/[Ll]ibrary/
/[ there ]Temp/
/[Oo]bj/
/[叠]Build/
/[Bb]uilds/
/[Cc]aptures/
/[Ll]ogs/
/[Mm]emoryCaptures/

# 模擬器與系統產生的無效檔案
sysdata.dat
.DS_Store
Thumbs.db

# 視覺化編輯器自動生成的專案檔
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# 系統當機產生的紀錄
CrashReport.*/